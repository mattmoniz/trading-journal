# DTC-Live-Globex -- a second real Trading Evaluator account on the same SierraChart-DTC
# instance (port 11199) as evaluator-simulator.env, created 2026-10-07 specifically to keep
# Globex-session test trades on their own account, separate from evaluator-simulator.env's
# RTH-style testing. Same instance/venue, same fictional-balance safety profile -- only the
# TRADE_ACCOUNT differs. Confirmed funded 2026-10-07 (a resting test order was accepted, not
# rejected for margin).
#
# Switch to this profile with: node scripts/switch_dtc_account.mjs evaluator-globex
DTC_HOST=172.27.192.1
DTC_PORT=11199
DTC_TRADE_ACCOUNT=DTC-Live-Globex
DTC_DLL_LIMIT_USD=1000
# Same backend as evaluator-simulator.env (confirmed live 2026-10-07) -- needs the 2-digit year
# code ("MNQZ26"), rejects the 1-digit form.
DTC_SYMBOL_YEAR_DIGITS=2
