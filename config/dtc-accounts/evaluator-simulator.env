# DTC-Live-Simulator -- a real Sierra Chart Trading Evaluator / Simulated Futures Trading
# Service account on the SECOND, separate Sierra Chart instance (SierraChart-DTC, port 11199).
# Fictional balance ($1,000,000, funded 2026-10-07), no connection to Sim1/Rithmic or any real
# broker. Built specifically for safer, isolated order-placement testing -- a bug here can place
# a real resting order on a real server-side venue, but never touches real capital or the
# production Sim1 connection.
#
# Switch to this profile with: node scripts/switch_dtc_account.mjs evaluator-simulator
DTC_HOST=172.27.192.1
DTC_PORT=11199
DTC_TRADE_ACCOUNT=DTC-Live-Simulator
DTC_DLL_LIMIT_USD=1000
# Confirmed live 2026-10-07: this venue (Trading Evaluator / Simulated Futures Trading Service)
# rejects the 1-digit year code ("MNQZ6" -- "not allowed based on the symbol") and requires 2
# digits ("MNQZ26") instead. Verified by a controlled round-trip test: resting, then clean cancel.
DTC_SYMBOL_YEAR_DIGITS=2

# Auto-rearm on server boot (2026-10-11, user-confirmed no real capital on this profile) --
# see connectionManager.js's own comment for why this is an explicit opt-in flag, not an
# inferred rule. Do NOT add this to a real-money account profile.
DTC_AUTO_REARM_SAFE=true
