# Sim1 -- the ORIGINAL Sierra Chart instance (port 11099), connected via Rithmic. This is the
# real-capital-ADJACENT account: it's the one the user actually trades/charts on day to day, and
# the one this app will switch BACK to once real-money order placement is ever turned on. Treat
# any order placed here with the same caution as a real account, even though it's a sim account
# today -- it shares the real production Rithmic connection and real market data feed.
#
# Switch to this profile with: node scripts/switch_dtc_account.mjs sim1
DTC_HOST=172.27.192.1
DTC_PORT=11099
DTC_TRADE_ACCOUNT=Sim1
DTC_DLL_LIMIT_USD=1000
# Confirmed live 2026-10-07: Rithmic/Sim1 wants the 1-digit contract year code ("MNQZ6").
DTC_SYMBOL_YEAR_DIGITS=1
