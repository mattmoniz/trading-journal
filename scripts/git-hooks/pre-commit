#!/usr/bin/env bash
# Pre-commit: blocks new hardcoded trading-threshold anti-patterns in acd.js/caseEngine.js.
# Only scans ADDED lines in the staged diff (not the whole file) so pre-existing
# violations elsewhere don't block unrelated commits — this catches new ones as they're
# introduced. Same 4 patterns as .claude/hooks/check-docs-drift.sh (that one is a Claude
# session Stop hook — end-of-session, non-blocking; this one is commit-time and blocking,
# so it also protects manual `git commit` outside a Claude Code session).
#
# Escape hatch for a deliberate, reviewed exception: ALLOW_HARDCODED=1 git commit ...
# (this is a targeted override for this hook only, unlike --no-verify which skips all hooks
# — don't use --no-verify to bypass this without asking, per project convention).

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO" || exit 1

[ "$ALLOW_HARDCODED" = "1" ] && exit 0

FILES="server/routes/acd.js server/services/caseEngine.js"
staged_targets="$(git diff --cached --name-only -- $FILES)"
[ -z "$staged_targets" ] && exit 0

hits=()
for f in $staged_targets; do
  added="$(git diff --cached -- "$f" | grep -E '^\+[^+]')"
  [ -z "$added" ] && continue

  # Pattern A: hardcoded suppression set literal
  m=$(echo "$added" | grep -E "new Set\(\['" | grep -v '_suppressedSetups\|_dowSuppressToday\|DAY_TYPE_CONDITIONAL\|SHADOW_SETUP\|displayPrimary\|SHADOW_SETUP_TYPES\|IB_SWEEP_TYPES')
  [ -n "$m" ] && hits+=("$f — new hardcoded Set literal (suppression list?):"$'\n'"$m")

  # Pattern B: hardcoded array of setup-type strings
  m=$(echo "$added" | grep -E "=\s*\['" | grep -iE 'fade|suppress|skip|monday|setup' | grep -v 'IB_SWEEP_TYPES\|STOP_RANGE\|DOW_NAMES')
  [ -n "$m" ] && hits+=("$f — new hardcoded setup-type array:"$'\n'"$m")

  # Pattern C: bare numeric STOP/TARGET assignment without _opt reference or Fallback annotation
  m=$(echo "$added" | grep -E 'const (STOP|TARGET) = [0-9]' | grep -v '_opt\|Fallback\|// sweep\|DEFAULT_\|STOP_RANGE\|MIN_STOP')
  [ -n "$m" ] && hits+=("$f — new hardcoded STOP/TARGET constant (use _opt or add // Fallback comment):"$'\n'"$m")

  # Pattern D: DOW-conditional numeric trading threshold
  m=$(echo "$added" | grep -E 'is(Monday|Dow|Tue|Wed|Thu|Fri)\s*\?.*[0-9]{2,}' \
    | grep -v '// data-derived\|etMinNow\|630\|960\|570\|629\|T12:00\|getDay\|post-IB\|10:30\|padEnd\|toFixed')
  [ -n "$m" ] && hits+=("$f — new DOW-conditional numeric trading threshold (use SETUP_STATUS_DOW pipeline instead):"$'\n'"$m")
done

if [ ${#hits[@]} -gt 0 ]; then
  echo "❌ pre-commit: hardcoded trading-threshold anti-pattern(s) detected in this commit:" >&2
  echo "" >&2
  printf '%s\n\n' "${hits[@]}" >&2
  echo "See CLAUDE.md 'No static thresholds' hard rule and 'New setup type checklist' convention." >&2
  echo "If this is a deliberate, reviewed exception: ALLOW_HARDCODED=1 git commit ..." >&2
  exit 1
fi

exit 0
