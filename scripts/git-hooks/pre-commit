#!/usr/bin/env bash
# Pre-commit: blocks new hardcoded trading-threshold anti-patterns in acd.js/caseEngine.js.
# Only scans ADDED lines in the staged diff (not the whole file) so pre-existing
# violations elsewhere don't block unrelated commits — this catches new ones as they're
# introduced. Same 4 patterns as .claude/hooks/check-docs-drift.sh (that one is a Claude
# session Stop hook — end-of-session, non-blocking; this one is commit-time and blocking,
# so it also protects manual `git commit` outside a Claude Code session). Pattern
# definitions live in scripts/hardcoded-threshold-patterns.sh — single source of truth
# for both hooks, don't inline the regexes here again.
#
# Escape hatch for a deliberate, reviewed exception: ALLOW_HARDCODED=1 git commit ...
# (this is a targeted override for this hook only, unlike --no-verify which skips all hooks
# — don't use --no-verify to bypass this without asking, per project convention).

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO" || exit 1

[ "$ALLOW_HARDCODED" = "1" ] && exit 0

source "$REPO/scripts/hardcoded-threshold-patterns.sh"

FILES="server/routes/acd.js server/services/caseEngine.js"
staged_targets="$(git diff --cached --name-only -- $FILES)"

hits=()
for f in $staged_targets; do
  added="$(git diff --cached -- "$f" | grep -E '^\+[^+]')"
  [ -z "$added" ] && continue

  m=$(echo "$added" | grep -E "$PATTERN_A" | grep -v "$PATTERN_A_EXCLUDE")
  [ -n "$m" ] && hits+=("$f — new $PATTERN_A_LABEL:"$'\n'"$m")

  m=$(echo "$added" | grep -E "$PATTERN_B" | grep -iE "$PATTERN_B_FILTER" | grep -v "$PATTERN_B_EXCLUDE")
  [ -n "$m" ] && hits+=("$f — new $PATTERN_B_LABEL:"$'\n'"$m")

  m=$(echo "$added" | grep -E "$PATTERN_C" | grep -v "$PATTERN_C_EXCLUDE")
  [ -n "$m" ] && hits+=("$f — new $PATTERN_C_LABEL:"$'\n'"$m")

  m=$(echo "$added" | grep -E "$PATTERN_D" | grep -v "$PATTERN_D_EXCLUDE")
  [ -n "$m" ] && hits+=("$f — new $PATTERN_D_LABEL:"$'\n'"$m")
done

# Pattern E scans broadly (not just acd.js/caseEngine.js) — found 2026-07-16 in a
# frontend modal and a table tooltip, neither of which patterns A-D's file scope covers.
# See hardcoded-threshold-patterns.sh for why this one isn't scoped like the others.
# instruments.js/contract.js are the canonical definition files -- they're SUPPOSED to
# contain "$20/pt" (NQ's real value) and may reference "$5/pt" in a comment describing
# the historical bug this pattern exists to catch. Excluded by path, not content, since
# no content-level exclude can tell "the correct definition" from "a wrong copy" apart.
# NOTE 2026-07-18: this glob was silently broken since it was written -- a bare '**' in a
# git pathspec does NOT expand recursively without the :(glob) magic prefix (confirmed:
# `git diff --cached --name-only -- 'server/**/*.js'` returned nothing against a real
# staged server/ file; `:(glob)server/**/*.js` returns it correctly). Meaning this whole
# check has never actually blocked a commit. Fixed here, found while wiring F/G below
# (same bug class would have made them equally silent).
e_targets="$(git diff --cached --name-only -- ':(glob)server/**/*.js' ':(glob)src/**/*.jsx' ':(glob)src/**/*.js' \
  ':(exclude)server/config/instruments.js' ':(exclude)src/constants/contract.js')"
for f in $e_targets; do
  added="$(git diff --cached -- "$f" | grep -E '^\+[^+]')"
  [ -z "$added" ] && continue
  m=$(echo "$added" | grep -E "$PATTERN_E" | grep -v "$PATTERN_E_EXCLUDE")
  [ -n "$m" ] && hits+=("$f — new $PATTERN_E_LABEL:"$'\n'"$m")
done

# Patterns F/G scan broadly across server/ and scripts/ (not just acd.js/caseEngine.js),
# diff-only like pattern E — a whole-file scan found 15/20 pre-existing hits respectively
# when these were added 2026-07-18, so this only catches new ones from here on.
f_targets="$(git diff --cached --name-only -- ':(glob)server/**/*.js' ':(glob)scripts/**/*.js' ':(glob)scripts/**/*.mjs' \
  ':(exclude)server/routes/dailyLogs.js' ':(exclude)server/routes/stats.js' ':(exclude)server/routes/dll.js')"
for f in $f_targets; do
  added="$(git diff --cached -- "$f" | grep -E '^\+[^+]')"
  [ -z "$added" ] && continue
  m=$(echo "$added" | grep -E "$PATTERN_F" | grep -v "$PATTERN_F_EXCLUDE")
  [ -n "$m" ] && hits+=("$f — new $PATTERN_F_LABEL:"$'\n'"$m")
done

g_targets="$(git diff --cached --name-only -- ':(glob)server/**/*.js' ':(glob)scripts/**/*.js' ':(glob)scripts/**/*.mjs' \
  ':(exclude)scripts/archive/**')"
for f in $g_targets; do
  added="$(git diff --cached -- "$f" | grep -E '^\+[^+]')"
  [ -z "$added" ] && continue
  m=$(echo "$added" | grep -E "$PATTERN_G" | grep -v "$PATTERN_G_EXCLUDE")
  [ -n "$m" ] && hits+=("$f — new $PATTERN_G_LABEL:"$'\n'"$m")
done

[ ${#hits[@]} -eq 0 ] && exit 0

if [ ${#hits[@]} -gt 0 ]; then
  echo "❌ pre-commit: hardcoded trading-threshold anti-pattern(s) detected in this commit:" >&2
  echo "" >&2
  printf '%s\n\n' "${hits[@]}" >&2
  echo "See CLAUDE.md 'No static thresholds' hard rule and 'New setup type checklist' convention." >&2
  echo "If this is a deliberate, reviewed exception: ALLOW_HARDCODED=1 git commit ..." >&2
  exit 1
fi

exit 0
